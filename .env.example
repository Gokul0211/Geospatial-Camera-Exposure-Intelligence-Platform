SHODAN_API_KEY=your_shodan_key_here
NEWS_API_KEY=your_newsapi_key_here
GROQ_API_KEY=your_groq_key_here
# Optional: Keyless vulnerability lookups use CISA KEV + free NVD queries automatically.
# No API key required for vulnerability checks.
NVD_API_KEY=

CORS_ORIGINS=http://localhost:5173

# Phase 4: API key protecting POST /api/detection-event from fabricated injection.
# Leave empty to disable auth in local dev.
# Generate a secure key: openssl rand -hex 32
# All GET routes remain open (public transparency — deliberate design choice).
DETECTION_API_KEY=

# Path to SQLite DB. In Docker this maps to a mounted volume (see docker-compose.yml).
# SQLite is fine for this project's demo/eval scale. Not suitable for concurrent writes
# at production scale — documented limitation in the report.
DATABASE_PATH=
