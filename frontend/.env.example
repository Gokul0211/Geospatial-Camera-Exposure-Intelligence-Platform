# Base URL of the FastAPI backend (python backend/main.py).
NEXT_PUBLIC_COBRA_API_URL=http://localhost:8000
# Set to "true" ONLY for a local session to show full IP addresses. Adds a persistent banner.
NEXT_PUBLIC_REVEAL_IP=false
# Shown in the nav and footer.
NEXT_PUBLIC_REPO_URL=https://github.com/Gokul0211/Geospatial-Camera-Exposure-Intelligence-Platform
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Self-hosted basemap (built by scripts/build-basemap.sh). Leave as is to use public/tiles/india.pmtiles.
NEXT_PUBLIC_BASEMAP_URL=/tiles/india.pmtiles
